# The production stack's public names, in one place (Lane P). Not secret: committed.
# deploy/prod passes this file to Compose; deploy.yml reads it for the Pages build. To move
# to another domain, change these two lines, the DNS routes (docs/runbook.md) and nothing else.
WEB_HOST=plumbline.alinedlabs.co
API_HOST=plumbline-api.alinedlabs.co
# The tunnel's UUID, printed by `cloudflared tunnel create plumbline-prod`: an identifier,
# not a credential (those are in /etc/plumbline/tunnel.json). Zeros until it exists.
TUNNEL_ID=00000000-0000-0000-0000-000000000000
