{
  "components": {
    "schemas": {
      "AnswerStatus": {
        "enum": [
          "answered",
          "partial",
          "abstained"
        ],
        "title": "AnswerStatus",
        "type": "string"
      },
      "AnswerSummary": {
        "additionalProperties": false,
        "description": "What the answer is, once it is complete.",
        "properties": {
          "abstain_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Abstain Reason"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "disclaimer": {
            "default": "Legal information, not legal advice. No lawyer has reviewed Plumbline's answers: read the cited article, and consult a qualified professional before acting.",
            "title": "Disclaimer",
            "type": "string"
          },
          "invalid_citations": {
            "default": 0,
            "minimum": 0,
            "title": "Invalid Citations",
            "type": "integer"
          },
          "jurisdictions": {
            "items": {
              "$ref": "#/components/schemas/Jurisdiction"
            },
            "title": "Jurisdictions",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          }
        },
        "required": [
          "status",
          "jurisdictions",
          "as_of",
          "confidence",
          "abstain_reason",
          "invalid_citations",
          "disclaimer"
        ],
        "title": "AnswerSummary",
        "type": "object"
      },
      "ArticleRef": {
        "additionalProperties": false,
        "description": "One statute article, pinned to the corpus edition it was read in.",
        "properties": {
          "article": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Article",
            "type": "string"
          },
          "edition": {
            "minLength": 1,
            "title": "Edition",
            "type": "string"
          },
          "jurisdiction": {
            "$ref": "#/components/schemas/Jurisdiction"
          },
          "law": {
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Law",
            "type": "string"
          },
          "paragraph": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Paragraph"
          }
        },
        "required": [
          "jurisdiction",
          "law",
          "article",
          "edition"
        ],
        "title": "ArticleRef",
        "type": "object"
      },
      "AskRequest": {
        "description": "The body `useChat` posts: the chat so far, plus Plumbline's own controls. Each\nquestion is answered on its own; earlier turns are not used yet.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "jurisdictions": {
            "items": {
              "$ref": "#/components/schemas/Jurisdiction"
            },
            "title": "Jurisdictions",
            "type": "array"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/UIMessage"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "CacheMode": {
        "description": "How model calls use cache/: replay reads only (tests, the hub, CI); record calls the\nmodel on a miss and writes the recording; live calls on a miss and writes nothing.",
        "enum": [
          "replay",
          "record",
          "live"
        ],
        "title": "CacheMode",
        "type": "string"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "One [n] marker in an answer and the span it quotes.",
        "properties": {
          "chunk_id": {
            "minLength": 1,
            "title": "Chunk Id",
            "type": "string"
          },
          "gloss": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Gloss"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "n": {
            "minimum": 1,
            "title": "N",
            "type": "integer"
          },
          "page": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "quote": {
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "ref": {
            "$ref": "#/components/schemas/ArticleRef"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "n",
          "chunk_id",
          "ref",
          "label",
          "quote",
          "gloss",
          "language",
          "verified",
          "page"
        ],
        "title": "Citation",
        "type": "object"
      },
      "DemoTier": {
        "description": "The degradation ladder: full (premium route on), free (free-tier models only),\nstatic (the static export serving stored answers).",
        "enum": [
          "full",
          "free",
          "static"
        ],
        "title": "DemoTier",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "cache_mode": {
            "$ref": "#/components/schemas/CacheMode"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "tier": {
            "$ref": "#/components/schemas/DemoTier"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "tier",
          "cache_mode"
        ],
        "title": "Health",
        "type": "object"
      },
      "Jurisdiction": {
        "enum": [
          "dubai",
          "spain",
          "colombia",
          "florida"
        ],
        "title": "Jurisdiction",
        "type": "string"
      },
      "Language": {
        "description": "Language of a source text. Questions and answers are always English.",
        "enum": [
          "en",
          "es"
        ],
        "title": "Language",
        "type": "string"
      },
      "Stage": {
        "enum": [
          "detecting",
          "retrieving",
          "reranking",
          "generating",
          "verifying"
        ],
        "title": "Stage",
        "type": "string"
      },
      "StatusEvent": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          }
        },
        "required": [
          "stage",
          "detail"
        ],
        "title": "StatusEvent",
        "type": "object"
      },
      "StreamError": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "message",
          "retryable"
        ],
        "title": "StreamError",
        "type": "object"
      },
      "TraceSummary": {
        "additionalProperties": false,
        "description": "What the answer cost and where it came from (the model-and-tier badge).",
        "properties": {
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          },
          "config_hash": {
            "title": "Config Hash",
            "type": "string"
          },
          "config_name": {
            "title": "Config Name",
            "type": "string"
          },
          "cost_usd": {
            "default": 0.0,
            "minimum": 0,
            "title": "Cost Usd",
            "type": "number"
          },
          "input_tokens": {
            "default": 0,
            "minimum": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "default": 0,
            "minimum": 0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "route": {
            "title": "Route",
            "type": "string"
          },
          "tier": {
            "$ref": "#/components/schemas/DemoTier"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings Ms",
            "type": "object"
          },
          "trace_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trace Url"
          }
        },
        "required": [
          "request_id",
          "config_name",
          "config_hash",
          "route",
          "model",
          "tier",
          "timings_ms",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "cached",
          "trace_url"
        ],
        "title": "TraceSummary",
        "type": "object"
      },
      "UIMessage": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/UIMessagePart"
            },
            "title": "Parts",
            "type": "array"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role"
        ],
        "title": "UIMessage",
        "type": "object"
      },
      "UIMessagePart": {
        "additionalProperties": true,
        "description": "A part of a chat message as the AI SDK sends it; only text parts are read.",
        "properties": {
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "UIMessagePart",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Tenancy-law answers with verified citations. Legal information, not legal advice.",
    "title": "Plumbline API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ask": {
      "post": {
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The answer as an AI SDK UI message stream (server-sent events)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask",
        "tags": [
          "answers"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
