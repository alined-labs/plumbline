# Copy to .env and fill in only what your lane needs. Frozen: a new key needs a brain block.
#
# .env is never committed, never read or printed by an agent, and never exported in a
# shell that runs Claude Code (Claude Code would bill ANTHROPIC_API_KEY instead of your
# plan). The app reads it through pydantic-settings; docker compose reads MODELS_BIND.
# Environment variables win over this file, which is how make check, the hub and CI
# force replay mode.

# --- Model calls ------------------------------------------------------------------------
# replay: read recordings in cache/ and never call a model (tests, the hub, CI).
# record: call the model on a miss and write the recording; commit it with your branch.
# live:   call the model on a miss and write nothing (production).
CACHE_MODE=replay
# The evals/configs/ file the API answers with.
ANSWER_CONFIG=A2

# Provider keys: only the lanes that record need them.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local services (compose.yaml) -----------------------------------------------------
# The throwaway local credentials; production values live only on the server.
DATABASE_URL=postgresql+psycopg://plumbline:plumbline@localhost:5433/plumbline
REDIS_URL=redis://localhost:6380/0
# A machine without the model containers points these at the one that serves them.
EMBED_URL=http://localhost:8081
RERANK_URL=http://localhost:8082
DOCLING_URL=http://localhost:5001
# On the machine that serves the model containers to the LAN: 0.0.0.0.
MODELS_BIND=127.0.0.1

# --- Serving ---------------------------------------------------------------------------
ENVIRONMENT=dev
# full, free or static: the tier until the settings table holds one.
DEMO_TIER=full
# Unlocks the tier switch and the kill switch; generate with: openssl rand -hex 32
ADMIN_TOKEN=
# A JSON list.
CORS_ORIGINS=["http://localhost:3000"]
DAILY_QUESTIONS_PER_IP=30
GEMINI_DAILY_CAP_USD=1.0
ANTHROPIC_DAILY_CAP_USD=1.0
COHERE_DAILY_CAP_USD=0.5
STUB_DELAY_MS=15

# The front end reads NEXT_PUBLIC_API_BASE_URL from apps/web/.env.local or the build
# environment (default http://localhost:8000); it is public, baked into the static export.
# NEXT_PUBLIC_SITE_URL, read the same way, is the site's own public origin (default
# http://localhost:3000), so link previews resolve; the deployment sets it.
