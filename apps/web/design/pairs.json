      "kind": "text"
    },
    {
      "fg": "syntax-number",
      "grounds": ["surface-sunken", "surface"],
      "min": 4.5,
      "kind": "text"
    },
    {
      "fg": "syntax-literal",
      "grounds": ["surface-sunken", "surface"],
      "min": 4.5,
      "kind": "text"
    }
  ],
  "distinct": {
    "min": 7,
    "groups": [
      ["success", "warning", "danger"],
      ["chart-1", "chart-2", "chart-3", "chart-4", "chart-5"]
    ]
  }
}
