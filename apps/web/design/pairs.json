      "kind": "text"
    },
    {
      "fg": "accent-fg",
      "grounds": ["accent", "accent-hover", "accent-active"],
      "min": 4.5,
      "kind": "text"
    },
    {
      "fg": "focus",
      "grounds": [
        "bg",
