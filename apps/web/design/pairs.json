    },
    {
      "fg": "chart-5",
      "grounds": ["bg", "surface"],
      "min": 3.0,
      "kind": "mark"
    },
    {
      "fg": "chart-axis",
      "grounds": ["bg", "surface"],
      "min": 3.0,
