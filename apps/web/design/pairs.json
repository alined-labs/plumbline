{
  "$description": "Checked by src/styles/tokens.test.ts in both themes. pairs: each foreground on each of its grounds; min is the WCAG 2.2 minimum, 4.5 for text and 3 for marks, control edges and focus rings. distinct: colours that must be told apart; every pair keeps at least min CIEDE2000 with normal vision and under simulated protanopia, deuteranopia and tritanopia.",
  "pairs": [
    {
      "fg": "fg",
      "grounds": [
        "bg",
        "bg-subtle",
        "surface",
        "surface-raised",
        "surface-sunken",
        "bg-hover",
        "bg-active",
        "highlight",
        "highlight-strong",
        "accent-subtle"
      ],
      "min": 4.5,
      "kind": "text"
    },
    {
      "fg": "fg-muted",
      "grounds": [
        "bg",
        "bg-subtle",
        "surface",
        "surface-raised",
        "surface-sunken",
        "bg-hover",
        "bg-active",
        "highlight",
        "accent-subtle"
      ],
      "min": 4.5,
      "kind": "text"
    },
    {
      "fg": "fg-subtle",
      "grounds": ["bg", "bg-subtle", "surface", "surface-raised", "surface-sunken"],
      "min": 4.5,
      "kind": "text"
    },
    {
      "fg": "fg-inverse",
      "grounds": ["inverse"],
      "min": 4.5,
      "kind": "text"
    },
    {
      "fg": "accent",
      "grounds": ["bg", "bg-subtle", "surface", "surface-raised"],
