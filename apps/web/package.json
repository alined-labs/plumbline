{
  "name": "@plumbline/web",
  "version": "0.1.0",
  "private": true,
  "description": "Plumbline's front end: Next.js App Router, statically exported.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "size-limit",
    "lighthouse": "node e2e/lighthouse.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.0",
    "@plumbline/ts-client": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "ai": "^7.0.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.6.0",
    "size-limit": "^14.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
